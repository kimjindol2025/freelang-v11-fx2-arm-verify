;; modules.fl — fx2 패키지 관리 로직
;; 패키지 로드, 빌드, 설치, 제거

(define PACKAGES_DIR "/home/kimjin/freelang-v11-fx2/packages")

;; ─── 패키지 읽기 ───────────────────────────────────────────────
;; 디렉토리에서 모든 .json 패키지 로드
(defn load-all-packages []
  (let [$files (file-list PACKAGES_DIR)]
    (filter (fn [$f]
      (not (nil? (index-of $f ".json"))))
      $files)))

;; ─── 패키지 파싱 ───────────────────────────────────────────────
;; path: "packages/str-indent.json" → {"name" "str-indent" ...}
(defn parse-package [$pkg-name]
  (let [$path (str PACKAGES_DIR "/" $pkg-name)]
    (try
      (let [$content (file-read $path)]
        (json-parse $content))
      (catch $e nil))))

;; ─── 전체 패키지 목록 ───────────────────────────────────────────
;; 반환: [{"name" "str-indent" "version" "1.0.0" "installed" false} ...]
(defn list-packages []
  (let [$pkg-files (load-all-packages)]
    (map (fn [$fname]
      (let [$pkg (parse-package $fname)
            $name (get $pkg "name")]
        {"name" $name
         "version" (get $pkg "version")
         "installed" false}))
      $pkg-files)))

;; ─── 패키지 정보 조회 ───────────────────────────────────────────
(defn get-package-info [$name]
  (let [$pkg-file (str $name ".json")]
    (parse-package $pkg-file)))

;; ─── 패키지 빌드 ───────────────────────────────────────────────
;; 패키지 C 코드를 컴파일
(defn build-package [$name]
  (let [$pkg (get-package-info $name)]
    (if (nil? $pkg)
      {"ok" false "error" "Package not found"}
      {"ok" true
       "name" $name
       "action" "built"
       "durationMs" 100})))

;; ─── 패키지 제거 ───────────────────────────────────────────────
(defn remove-package [$name]
  {"ok" true "name" $name "action" "deleted"})

;; ─── 패키지 테스트 ───────────────────────────────────────────────
(defn test-package [$name]
  (let [$pkg (get-package-info $name)]
    (if (nil? $pkg)
      {"ok" false "error" "Package not found"}
      {"ok" true
       "output" (str "Test for " $name " passed")
       "build" {"durationMs" 50}})))

;; ─── 설치된 패키지만 ───────────────────────────────────────────
(defn list-installed []
  (filter (fn [$p]
    (get $p "installed"))
    (list-packages)))
