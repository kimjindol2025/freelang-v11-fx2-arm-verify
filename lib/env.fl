;; lib/env.fl — 환경변수 헬퍼
;; (load "/home/kimjin/freelang-v11-fx2/lib/env.fl")

;; 필수 환경변수 — 없으면 에러 출력 후 종료
(defn env-require [$name]
  (let [$v (env-get $name)]
    (if (nil? $v)
      (do (println (str "[env] 필수 환경변수 없음: " $name))
          (shell-run "exit 1")
          "")
      $v)))

;; 기본값 포함
(defn env-default [$name $default]
  (let [$v (env-get $name)]
    (if (nil? $v) $default $v)))

;; 정수 환경변수
(defn env-int [$name $default]
  (let [$v (env-get $name)]
    (if (nil? $v) $default (str-to-num $v))))

;; 불리언 환경변수 ("true"/"1"/"yes")
(defn env-bool [$name $default]
  (let [$v (env-get $name)]
    (if (nil? $v) $default
      (or (= $v "true") (= $v "1") (= $v "yes")))))

;; 포트 (기본 3000)
(defn env-port [$default]
  (env-int "PORT" $default))
