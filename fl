#!/usr/bin/env bash
# fl — FreeLang 프로젝트 CLI
# 사용법:
#   fl new <name> [--profile p1,p2,...]
#   fl build <input.fl> [output] [--no-net]
#   fl plan  <input.fl> [output]
#   fl check <input.fl>
#   fl graph <input.fl>
#   fl profile list
#   fl profile add <name>[@version]

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
FX_HOST="${FX_HOST:-http://localhost:40330}"

_ok()   { echo "✓ $*"; }
_fail() { echo "✗ $*" >&2; }
_info() { echo "  $*"; }

FL_TOML_PARSE_SRC="$SCRIPT_DIR/fl-toml-parse.c"
FL_TOML_PARSE_BIN="$SCRIPT_DIR/.fl-toml-parse"
FL_BUILD_PLAN_SRC="$SCRIPT_DIR/fl-build-plan.c"
FL_BUILD_PLAN_BIN="$SCRIPT_DIR/.fl-build-plan"
FL_MODULE_PARSE_SRC="$SCRIPT_DIR/fl-module-parse.c"
FL_MODULE_PARSE_BIN="$SCRIPT_DIR/.fl-module-parse"

build_fl_toml_parse() {
  if [ -x "$FL_TOML_PARSE_BIN" ] && [ "$FL_TOML_PARSE_BIN" -nt "$FL_TOML_PARSE_SRC" ]; then
    return 0
  fi
  if ! cc -O2 -std=c99 "$FL_TOML_PARSE_SRC" -o "$FL_TOML_PARSE_BIN" 2>/tmp/fl-toml-parse-build.log; then
    echo "[fl] fl-toml-parse.c build failed" >&2
    cat /tmp/fl-toml-parse-build.log >&2
    return 1
  fi
}

build_fl_module_parse() {
  if [ -x "$FL_MODULE_PARSE_BIN" ] && [ "$FL_MODULE_PARSE_BIN" -nt "$FL_MODULE_PARSE_SRC" ]; then
    return 0
  fi
  if ! cc -O2 -std=c99 "$FL_MODULE_PARSE_SRC" -o "$FL_MODULE_PARSE_BIN" 2>/tmp/fl-module-parse-build.log; then
    echo "[fl] fl-module-parse.c build failed" >&2
    cat /tmp/fl-module-parse-build.log >&2
    return 1
  fi
}

build_fl_build_plan() {
  build_fl_module_parse || return 1
  if [ -x "$FL_BUILD_PLAN_BIN" ] && [ "$FL_BUILD_PLAN_BIN" -nt "$FL_BUILD_PLAN_SRC" ] && [ "$FL_BUILD_PLAN_BIN" -nt "$FL_MODULE_PARSE_SRC" ]; then
    return 0
  fi
  if ! cc -O2 -std=c99 "$FL_BUILD_PLAN_SRC" -o "$FL_BUILD_PLAN_BIN" 2>/tmp/fl-build-plan-build.log; then
    echo "[fl] fl-build-plan.c build failed" >&2
    cat /tmp/fl-build-plan-build.log >&2
    return 1
  fi
}

run_fl_toml_parse() {
  build_fl_toml_parse || return 1
  "$FL_TOML_PARSE_BIN" "$@"
}

run_fl_build_plan() {
  build_fl_build_plan || return 1
  "$FL_BUILD_PLAN_BIN" "$@"
}

cmd=$1; shift

case "$cmd" in
# ─────────────────────────────
# fl build <input.fl> [output] [flags]
# fl plan  <input.fl> [output]
# fl check <input.fl>
# fl graph <input.fl>
# ─────────────────────────────
build)
  if [[ -f "fx.toml" ]] && [[ -z "$1" || "$1" == --* ]]; then
    BUILD_FLAGS=("$@")
    PARSED=$(run_fl_toml_parse "fx.toml" 2>/dev/null) || exit 1
    ENTRY=$(run_fl_toml_parse --get project.entry "fx.toml" 2>/dev/null)
    OUTPUT=$(run_fl_toml_parse --get project.output "fx.toml" 2>/dev/null)
    if [[ -z "$ENTRY" ]]; then _fail "fx.toml에 [project] entry 없음"; exit 1; fi
    if [[ -z "$OUTPUT" ]]; then OUTPUT="${ENTRY%.fl}"; fi
    if [[ ! -f "$ENTRY" ]]; then _fail "entry 파일 없음: $ENTRY"; exit 1; fi
    echo "🔨 fl build: $ENTRY → $OUTPUT"; echo ""
    PKG_JSON=$(run_fl_toml_parse --runtime-payload "fx.toml" 2>/dev/null || true)
    if [[ -n "$PKG_JSON" ]]; then
      echo "📦 런타임 초기화..."
      INIT_RESULT=$(curl -s -X POST "$FX_HOST/fx/project/init" \
        -H "Content-Type: application/json" -d "$PKG_JSON" 2>/dev/null)
      INIT_FILE=$(mktemp /tmp/fx2-fl-init.XXXXXX.json)
      printf '%s' "$INIT_RESULT" > "$INIT_FILE"
      INIT_OK=$(run_fl_toml_parse --new-init-ok "$INIT_FILE" 2>/dev/null || true)
      if [[ "$INIT_OK" == "True" ]]; then
        run_fl_toml_parse --new-init-package-summary "$INIT_FILE" 2>/dev/null || true
        _ok "런타임 준비 완료"; echo ""
      else
        ERR=$(run_fl_toml_parse --new-init-error "$INIT_FILE" 2>/dev/null || true)
        _fail "런타임 초기화 실패: $ERR"; rm -f "$INIT_FILE"; exit 1
      fi
      rm -f "$INIT_FILE"
    fi
    exec bash "$SCRIPT_DIR/fl-build.sh" "$ENTRY" "$OUTPUT" "${BUILD_FLAGS[@]}"
  else
    exec bash "$SCRIPT_DIR/fl-build.sh" "$@"
  fi
  ;;

plan)
  INPUT=$1; shift
  OUTPUT="${1:-$(basename "${INPUT%.fl}")}"
  run_fl_build_plan "$INPUT" "$SCRIPT_DIR" "$OUTPUT" plan
  exit $?
  ;;

check)
  INPUT=$1
  OUTPUT="$(basename "${INPUT%.fl}")"
  run_fl_build_plan "$INPUT" "$SCRIPT_DIR" "$OUTPUT" check
  exit $?
  ;;

graph)
  INPUT=$1
  OUTPUT="$(basename "${INPUT%.fl}")"
  run_fl_build_plan "$INPUT" "$SCRIPT_DIR" "$OUTPUT" graph
  exit $?
  ;;

# ─────────────────────────────
# fl new <name> [--profile p1,p2,...] [--pkg p1,p2,...]
# ─────────────────────────────
new)
  NAME=$1; shift
  if [[ -z "$NAME" ]]; then
    echo "사용법: fl new <name> [--profile p1,p2,...] [--pkg p1,p2,...]" >&2; exit 1
  fi

  PROFILES=()
  PKGS=()
  while [[ $# -gt 0 ]]; do
    case $1 in
      --profile|-p) shift; IFS=',' read -ra PROFILES <<< "$1" ;;
      --pkg)        shift; IFS=',' read -ra PKGS    <<< "$1" ;;
    esac
    shift
  done

  if [[ -d "$NAME" ]]; then
    _fail "디렉토리 이미 존재: $NAME"; exit 1
  fi

  mkdir -p "$NAME"
  _ok "디렉토리 생성: $NAME/"

  {
    echo "[project]"
    echo "name   = \"$NAME\""
    echo "entry  = \"app.fl\""
    echo "output = \"$NAME\""
    echo ""
    echo "[runtime]"
    if [[ ${#PROFILES[@]} -gt 0 ]]; then
      echo "profiles = [$(printf '"%s", ' "${PROFILES[@]}" | sed 's/, $//')]"
    fi
    if [[ ${#PKGS[@]} -gt 0 ]]; then
      echo "packages = [$(printf '"%s", ' "${PKGS[@]}" | sed 's/, $//')]"
    fi
  } > "$NAME/fx.toml"
  _ok "fx.toml 생성"

  cat > "$NAME/app.fl" << 'FL'
(println "Hello, fx2!")
FL
  _ok "app.fl 생성"

  cat > "$NAME/.gitignore" << 'GI'
# 빌드 결과물
*.bin
/out/
GI
  echo "/$NAME" >> "$NAME/.gitignore"
  _ok ".gitignore 생성"

  if [[ ${#PROFILES[@]} -gt 0 ]] || [[ ${#PKGS[@]} -gt 0 ]]; then
    echo ""
    echo "📦 런타임 초기화..."
    if ! build_fl_toml_parse; then
      exit 1
    fi
    PAYLOAD=$("$FL_TOML_PARSE_BIN" --new-payload --profiles "${#PROFILES[@]}" "${PROFILES[@]}" --packages "${#PKGS[@]}" "${PKGS[@]}")
    RESULT=$(curl -s -X POST "$FX_HOST/fx/project/init" \
      -H "Content-Type: application/json" -d "$PAYLOAD" 2>/dev/null)
    RESULT_FILE=$(mktemp /tmp/fx2-fl-new.XXXXXX.json)
    printf '%s' "$RESULT" > "$RESULT_FILE"
    INIT_OK=$("$FL_TOML_PARSE_BIN" --new-init-ok "$RESULT_FILE" 2>/dev/null || true)
    if [[ "$INIT_OK" == "True" ]]; then
      "$FL_TOML_PARSE_BIN" --new-init-package-summary "$RESULT_FILE" 2>/dev/null || true
      _ok "런타임 준비 완료"
    else
      ERR=$("$FL_TOML_PARSE_BIN" --new-init-error "$RESULT_FILE" 2>/dev/null || true)
      _fail "런타임 초기화 실패: $ERR"
    fi
    rm -f "$RESULT_FILE"
  fi

  echo ""
  echo "✓ 프로젝트 준비 완료:"
  echo "  cd $NAME"
  echo "  fl build    # 빌드"
  echo "  fl run      # 실행"
  ;;

# ─────────────────────────────
# fl profile list
# fl profile add <name>[@version]
# ─────────────────────────────

profile)
  subcmd=$1; shift
  case "$subcmd" in
    list)
      TMP=$(mktemp /tmp/fx2-fl-profile-list.XXXXXX.json)
      curl -s "$FX_HOST/fx/profiles" > "$TMP"
      build_fl_toml_parse || exit 1
      "$FL_TOML_PARSE_BIN" --profile-list "$TMP" 2>/dev/null
      rm -f "$TMP"
      ;;

    add)
      SPEC=$1
      if [[ -z "$SPEC" ]]; then
        echo "사용법: fl profile add <name>[@version]" >&2; exit 1
      fi
      PNAME="${SPEC%%@*}"
      PVER="${SPEC##*@}"
      if [[ "$PVER" == "$SPEC" ]]; then PVER=""; fi

      if [[ -n "$PVER" ]]; then
        PAYLOAD="{\"profiles\":[{\"name\":\"$PNAME\",\"version\":\"$PVER\"}]}"
      else
        PAYLOAD="{\"profiles\":[\"$PNAME\"]}"
      fi

      TMP=$(mktemp /tmp/fx2-fl-profile-add.XXXXXX.json)
      RESULT=$(curl -s -X POST "$FX_HOST/fx/project/init" \
        -H "Content-Type: application/json" \
        -d "$PAYLOAD" 2>/dev/null)
      printf '%s' "$RESULT" > "$TMP"
      build_fl_toml_parse || exit 1
      "$FL_TOML_PARSE_BIN" --profile-add-output "$TMP" 2>/dev/null
      rm -f "$TMP"
      ;;

    *)
      echo "사용법: fl profile list | fl profile add <name>[@version]" ;;
  esac
  ;;

# ─────────────────────────────
# fl run [args...]
# ─────────────────────────────
run)
  if [[ "$1" == "--help" || "$1" == "-h" ]]; then
  if [[ "$1" == "--rebuild" ]]; then
    shift
    bash "$0" build || exit 1
  fi
    echo "사용법: fl run [args...]"
    echo "  현재 프로젝트의 fx.toml output을 빌드 후 실행"
    echo "  fl run --rebuild  기존 바이너리를 무시하고 다시 빌드"
    exit 0
  fi
  if [[ ! -f "fx.toml" ]]; then _fail "fx.toml 없음"; exit 1; fi
  build_fl_toml_parse || exit 1
  OUTPUT=$("$FL_TOML_PARSE_BIN" --get project.output "fx.toml" 2>/dev/null)
  if [[ -z "$OUTPUT" ]]; then _fail "fx.toml에 output 없음"; exit 1; fi
  if [[ ! -f "./$OUTPUT" ]]; then
    _info "바이너리 없음 — 빌드 먼저..."
    bash "$0" build || exit 1; echo ""
  fi
  "./$OUTPUT" "$@"
  STATUS=$?
  if [[ "$STATUS" == "126" || "$STATUS" == "127" ]]; then
    _fail "실행 파일을 현재 환경에서 시작할 수 없습니다: $OUTPUT"
    _info "fl run --rebuild 로 다시 빌드하세요"
  fi
  exit "$STATUS"
  ;;

# ─────────────────────────────
# fl pkg add <name> | fl pkg list
# ─────────────────────────────
pkg)
  subcmd=$1; shift
  case "$subcmd" in
    add)
      NAME=$1
      if [[ -z "$NAME" ]]; then echo "사용법: fl pkg add <name>" >&2; exit 1; fi
      PKG_FILE="$SCRIPT_DIR/packages/$NAME.json"
      if [[ ! -f "$PKG_FILE" ]]; then _fail "패키지 없음: $NAME"; exit 1; fi
      build_fl_toml_parse || exit 1
      PAYLOAD=$("$FL_TOML_PARSE_BIN" --run-pkg-import-payload "$NAME")
      RESULT=$(curl -s -X POST "$FX_HOST/fx/fns/import" \
        -H "Content-Type: application/json" -d "$PAYLOAD" 2>/dev/null)
      TMP=$(mktemp /tmp/fx2-fl-pkg-add.XXXXXX.json)
      printf '%s' "$RESULT" > "$TMP"
      "$FL_TOML_PARSE_BIN" --run-pkg-import-output "$NAME" "$TMP" 2>/dev/null
      rm -f "$TMP"
      ;;
    list)
      build_fl_toml_parse || exit 1
      TMP=$(mktemp /tmp/fx2-fl-pkg-list.XXXXXX.json)
      curl -s "$FX_HOST/fx/fns" > "$TMP"
      "$FL_TOML_PARSE_BIN" --pkg-list "$TMP" 2>/dev/null
      rm -f "$TMP"
      ;;
    *) echo "사용법: fl pkg add <name> | fl pkg list" ;;
  esac
  ;;

# ─────────────────────────────
help|--help|-h|'')
  cat << HELP
fl — FreeLang 프로젝트 CLI

빌드:
  fl build                                  fx.toml 기반 런타임 초기화 + ELF 빌드
  fl build <input.fl> [output] [--no-net]   직접 빌드 (fx.toml 없이)
  fl run [args...]                          빌드 후 실행 (없으면 자동 빌드)
  fl plan  <input.fl> [output]              의존성 선언 출력
  fl check <input.fl>                       declared vs installed 검사
  fl graph <input.fl>                       의존성 트리 출력

패키지:
  fl pkg add <name>                         패키지 추가 + 런타임 재빌드
  fl pkg list                               설치된 패키지 목록

프로젝트:
  fl new <name> [--profile p1,p2,...]       프로젝트 생성 + 런타임 초기화
  fl profile list                           프로파일 목록
  fl profile add <name>[@version]           프로파일 추가

환경변수:
  FX_HOST   fl-source-manager 주소 (기본: http://localhost:40330)

예시:
  fl new my-api --profile web,math
  cd my-api && fl build && fl run
  fl build blog.fl heungbo-blog
  fl pkg add str-starts-with
  fl pkg list
HELP
  ;;

*)
  echo "알 수 없는 명령: $cmd (fl --help 참조)" >&2; exit 1 ;;
esac
