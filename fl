#!/usr/bin/env bash
# fl — FreeLang 프로젝트 CLI
# 사용법:
#   fl new <name> [--profile p1,p2,...]
#   fl build <input.fl> [output] [--no-net]
#   fl plan  <input.fl> [output]
#   fl check <input.fl>
#   fl graph <input.fl>
#   fl profile list
#   fl profile add <name>[@version]

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
FX_HOST="${FX_HOST:-http://localhost:40330}"
CGC_BIN="${CGC_BIN:-/home/kimjin/freelang-v11/bin/cgc-bin}"

_ok()   { echo "✓ $*"; }
_fail() { echo "✗ $*" >&2; }
_info() { echo "  $*"; }

cmd=$1; shift

case "$cmd" in
# ─────────────────────────────
# fl build <input.fl> [output] [flags]
# fl plan  <input.fl> [output]
# fl check <input.fl>
# fl graph <input.fl>
# ─────────────────────────────
build)
  # fx.toml 있고 인자 없으면 → 런타임 초기화 포함 자동 빌드
  # 그 외 → 기존 방식 (fl build <input.fl> [output])
  if [[ -f "fx.toml" ]] && [[ -z "$1" || "$1" == --* ]]; then
    BUILD_FLAGS=("$@")
    PARSED=$(python3 "$SCRIPT_DIR/fl-toml-parse.py" "fx.toml" 2>/dev/null)
    ENTRY=$(echo "$PARSED" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('project',{}).get('entry',''))" 2>/dev/null)
    OUTPUT=$(echo "$PARSED" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('project',{}).get('output',''))" 2>/dev/null)
    if [[ -z "$ENTRY" ]]; then _fail "fx.toml에 [project] entry 없음"; exit 1; fi
    if [[ -z "$OUTPUT" ]]; then OUTPUT="${ENTRY%.fl}"; fi
    if [[ ! -f "$ENTRY" ]]; then _fail "entry 파일 없음: $ENTRY"; exit 1; fi
    echo "🔨 fl build: $ENTRY → $OUTPUT"; echo ""
    PKG_JSON=$(echo "$PARSED" | python3 -c "
import json, sys
d = json.load(sys.stdin)
rt = d.get('runtime', {})
pkgs = rt.get('packages', [])
profs = rt.get('profiles', [])
payload = {}
if pkgs:  payload['packages'] = pkgs
if profs: payload['profiles'] = profs
if payload: print(json.dumps(payload))
" 2>/dev/null)
    if [[ -n "$PKG_JSON" ]]; then
      echo "📦 런타임 초기화..."
      INIT_RESULT=$(curl -s -X POST "$FX_HOST/fx/project/init" \
        -H "Content-Type: application/json" -d "$PKG_JSON" 2>/dev/null)
      INIT_OK=$(echo "$INIT_RESULT" | python3 -c "import json,sys; print(json.load(sys.stdin).get('ok',False))" 2>/dev/null)
      if [[ "$INIT_OK" == "True" ]]; then
        echo "$INIT_RESULT" | python3 -c "
import json,sys
d=json.load(sys.stdin)
added=[p['name'] for p in d.get('packages',[]) if p.get('action')!='skipped']
skip=[p['name'] for p in d.get('packages',[]) if p.get('action')=='skipped']
if added: print('  + '+', '.join(added))
if skip:  print('  ↩ skipped: '+', '.join(skip))
" 2>/dev/null
        _ok "런타임 준비 완료"; echo ""
      else
        ERR=$(echo "$INIT_RESULT" | python3 -c "import json,sys; print(json.load(sys.stdin).get('error',''))" 2>/dev/null)
        _fail "런타임 초기화 실패: $ERR"; exit 1
      fi
    fi
    exec bash "$SCRIPT_DIR/fl-build.sh" "$ENTRY" "$OUTPUT" "${BUILD_FLAGS[@]}"
  else
    exec bash "$SCRIPT_DIR/fl-build.sh" "$@"
  fi
  ;;

plan)
  INPUT=$1; shift
  OUTPUT="${1:-$(basename "${INPUT%.fl}")}"
  exec python3 "$SCRIPT_DIR/fl-build-plan.py" "$INPUT" "$SCRIPT_DIR" "$OUTPUT" plan
  ;;

check)
  INPUT=$1
  OUTPUT="$(basename "${INPUT%.fl}")"
  exec python3 "$SCRIPT_DIR/fl-build-plan.py" "$INPUT" "$SCRIPT_DIR" "$OUTPUT" check
  ;;

graph)
  INPUT=$1
  OUTPUT="$(basename "${INPUT%.fl}")"
  exec python3 "$SCRIPT_DIR/fl-build-plan.py" "$INPUT" "$SCRIPT_DIR" "$OUTPUT" graph
  ;;

# ─────────────────────────────
# fl new <name> [--profile p1,p2,...] [--pkg p1,p2,...]
# ─────────────────────────────
new)
  NAME=$1; shift
  if [[ -z "$NAME" ]]; then
    echo "사용법: fl new <name> [--profile p1,p2,...] [--pkg p1,p2,...]" >&2; exit 1
  fi

  PROFILES=()
  PKGS=()
  while [[ $# -gt 0 ]]; do
    case $1 in
      --profile|-p) shift; IFS=',' read -ra PROFILES <<< "$1" ;;
      --pkg)        shift; IFS=',' read -ra PKGS    <<< "$1" ;;
    esac
    shift
  done

  if [[ -d "$NAME" ]]; then
    _fail "디렉토리 이미 존재: $NAME"; exit 1
  fi

  mkdir -p "$NAME"
  _ok "디렉토리 생성: $NAME/"

  # ── fx.toml 생성 ──────────────────────────────────────────────
  {
    echo "[project]"
    echo "name   = \"$NAME\""
    echo "entry  = \"app.fl\""
    echo "output = \"$NAME\""
    echo ""
    echo "[runtime]"
    if [[ ${#PROFILES[@]} -gt 0 ]]; then
      echo "profiles = [$(printf '"%s", ' "${PROFILES[@]}" | sed 's/, $//')]"
    fi
    if [[ ${#PKGS[@]} -gt 0 ]]; then
      echo "packages = [$(printf '"%s", ' "${PKGS[@]}" | sed 's/, $//')]"
    fi
  } > "$NAME/fx.toml"
  _ok "fx.toml 생성"

  # ── app.fl 생성 ────────────────────────────────────────────────
  cat > "$NAME/app.fl" << 'FL'
(println "Hello, fx2!")
FL
  _ok "app.fl 생성"

  # ── .gitignore ─────────────────────────────────────────────────
  cat > "$NAME/.gitignore" << 'GI'
# 빌드 결과물
*.bin
/out/
GI
  # 바이너리 이름도 추가
  echo "/$NAME" >> "$NAME/.gitignore"
  _ok ".gitignore 생성"

  # ── 런타임 초기화 (프로파일/패키지 있을 때) ─────────────────────
  if [[ ${#PROFILES[@]} -gt 0 ]] || [[ ${#PKGS[@]} -gt 0 ]]; then
    echo ""
    echo "📦 런타임 초기화..."
    PAYLOAD=$(python3 -c "
import json, sys
profs = '${PROFILES[*]}'.split() if '${PROFILES[*]}' else []
pkgs  = '${PKGS[*]}'.split() if '${PKGS[*]}' else []
d = {}
if profs: d['profiles'] = profs
if pkgs:  d['packages'] = pkgs
print(json.dumps(d))
" 2>/dev/null)
    RESULT=$(curl -s -X POST "$FX_HOST/fx/project/init" \
      -H "Content-Type: application/json" -d "$PAYLOAD" 2>/dev/null)
    INIT_OK=$(echo "$RESULT" | python3 -c "import json,sys; print(json.load(sys.stdin).get('ok',False))" 2>/dev/null)
    if [[ "$INIT_OK" == "True" ]]; then
      echo "$RESULT" | python3 -c "
import json,sys
d=json.load(sys.stdin)
added=[p['name'] for p in d.get('packages',[]) if p.get('action')!='skipped']
skip=[p['name'] for p in d.get('packages',[]) if p.get('action')=='skipped']
if added: print('  + '+', '.join(added))
if skip:  print('  ↩ skipped: '+', '.join(skip))
" 2>/dev/null
      _ok "런타임 준비 완료"
    else
      ERR=$(echo "$RESULT" | python3 -c "import json,sys; print(json.load(sys.stdin).get('error',''))" 2>/dev/null)
      _fail "런타임 초기화 실패: $ERR"
    fi
  fi

  echo ""
  echo "✓ 프로젝트 준비 완료:"
  echo "  cd $NAME"
  echo "  fl build    # 빌드"
  echo "  fl run      # 실행"
  ;;

# ─────────────────────────────
# fl profile list
# fl profile add <name>[@version]
# ─────────────────────────────
profile)
  subcmd=$1; shift
  case "$subcmd" in
    list)
      curl -s "$FX_HOST/fx/profiles" | python3 -c "
import json,sys
d=json.load(sys.stdin)
print(f'프로파일 {d[\"count\"]}개:')
for p in d['profiles']:
    icon = '✓' if p['installed'] else '○'
    deps = (' (depends: ' + ', '.join(p.get('depends',[])) + ')') if p.get('depends') else ''
    print(f'  {icon} {p[\"name\"]:10s}  {len(p[\"packages\"]):2d}개 함수{deps}')
" 2>/dev/null
      ;;

    add)
      SPEC=$1
      if [[ -z "$SPEC" ]]; then
        echo "사용법: fl profile add <name>[@version]" >&2; exit 1
      fi
      PNAME="${SPEC%%@*}"
      PVER="${SPEC##*@}"
      if [[ "$PVER" == "$SPEC" ]]; then PVER=""; fi

      if [[ -n "$PVER" ]]; then
        PAYLOAD="{\"profiles\":[{\"name\":\"$PNAME\",\"version\":\"$PVER\"}]}"
      else
        PAYLOAD="{\"profiles\":[\"$PNAME\"]}"
      fi

      RESULT=$(curl -s -X POST "$FX_HOST/fx/project/init" \
        -H "Content-Type: application/json" \
        -d "$PAYLOAD" 2>/dev/null)

      echo "$RESULT" | python3 -c "
import json,sys
d=json.load(sys.stdin)
if d.get('ok'):
    print(f'✓ {d[\"action\"]}')
    for p in d.get('packages',[]):
        icon = '↩' if p['action']=='skipped' else '+'
        print(f'  {icon} {p[\"name\"]} ({p[\"action\"]})')
    rp = d.get('resolved_profiles',[])
    if rp: print(f'  depends chain: {\" → \".join(rp)}')
else:
    print(f'✗ {d.get(\"error\",\"알 수 없는 오류\")}')
    if d.get('error') == 'PROFILE_ABI_MISMATCH':
        print(f'  프로파일: {d.get(\"profile\")} expected={d.get(\"expected\")} got={d.get(\"got\")}')
" 2>/dev/null
      ;;

    *)
      echo "사용법: fl profile list | fl profile add <name>[@version]" ;;
  esac
  ;;

# ─────────────────────────────
# fl run [args...]
# ─────────────────────────────
run)
  if [[ ! -f "fx.toml" ]]; then _fail "fx.toml 없음"; exit 1; fi
  PARSED=$(python3 "$SCRIPT_DIR/fl-toml-parse.py" "fx.toml" 2>/dev/null)
  OUTPUT=$(echo "$PARSED" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('project',{}).get('output',''))" 2>/dev/null)
  if [[ -z "$OUTPUT" ]]; then _fail "fx.toml에 output 없음"; exit 1; fi
  if [[ ! -f "./$OUTPUT" ]]; then
    _info "바이너리 없음 — 빌드 먼저..."
    bash "$0" build || exit 1; echo ""
  fi
  exec "./$OUTPUT" "$@"
  ;;

# ─────────────────────────────
# fl pkg add <name> | fl pkg list
# ─────────────────────────────
pkg)
  subcmd=$1; shift
  case "$subcmd" in
    add)
      NAME=$1
      if [[ -z "$NAME" ]]; then echo "사용법: fl pkg add <name>" >&2; exit 1; fi
      PKG_FILE="$SCRIPT_DIR/packages/$NAME.json"
      if [[ ! -f "$PKG_FILE" ]]; then _fail "패키지 없음: $NAME"; exit 1; fi
      echo "📦 패키지 추가: $NAME"
      RESULT=$(curl -s -X POST "$FX_HOST/fx/fns" \
        -H "Content-Type: application/json" -d @"$PKG_FILE" 2>/dev/null)
      OK=$(echo "$RESULT" | python3 -c "import json,sys; print(json.load(sys.stdin).get('ok',False))" 2>/dev/null)
      if [[ "$OK" == "True" ]]; then
        _ok "$NAME 등록"
        BUILD_RESULT=$(curl -s -X POST "$FX_HOST/fx/build" 2>/dev/null)
        BUILD_OK=$(echo "$BUILD_RESULT" | python3 -c "import json,sys; print(json.load(sys.stdin).get('ok',False))" 2>/dev/null)
        [[ "$BUILD_OK" == "True" ]] && _ok "런타임 빌드 완료" || _fail "런타임 빌드 실패"
      else
        ERR=$(echo "$RESULT" | python3 -c "import json,sys; print(json.load(sys.stdin).get('error',''))" 2>/dev/null)
        _fail "$NAME 등록 실패: $ERR"
      fi
      ;;
    list)
      curl -s "$FX_HOST/fx/fns" | python3 -c "
import json,sys
d=json.load(sys.stdin)
fns=d.get('functions',d.get('fns',[]))
print(f'설치된 패키지 {len(fns)}개:')
for f in sorted(fns, key=lambda x: x.get('name','')):
    print(f'  {f.get(\"name\",\"?\")}  ({f.get(\"args\",\"?\")}인자)')
" 2>/dev/null
      ;;
    *) echo "사용법: fl pkg add <name> | fl pkg list" ;;
  esac
  ;;

# ─────────────────────────────
help|--help|-h|'')
  cat << HELP
fl — FreeLang 프로젝트 CLI

빌드:
  fl build                                  fx.toml 기반 런타임 초기화 + ELF 빌드
  fl build <input.fl> [output] [--no-net]   직접 빌드 (fx.toml 없이)
  fl run [args...]                          빌드 후 실행 (없으면 자동 빌드)
  fl plan  <input.fl> [output]              의존성 선언 출력
  fl check <input.fl>                       declared vs installed 검사
  fl graph <input.fl>                       의존성 트리 출력

패키지:
  fl pkg add <name>                         패키지 추가 + 런타임 재빌드
  fl pkg list                               설치된 패키지 목록

프로젝트:
  fl new <name> [--profile p1,p2,...]       프로젝트 생성 + 런타임 초기화
  fl profile list                           프로파일 목록
  fl profile add <name>[@version]           프로파일 추가

환경변수:
  FX_HOST   fl-source-manager 주소 (기본: http://localhost:40330)
  CGC_BIN   cgc 바이너리 경로

예시:
  fl new my-api --profile web,math
  cd my-api && fl build && fl run
  fl build blog.fl heungbo-blog
  fl pkg add str-starts-with
  fl pkg list
HELP
  ;;

*)
  echo "알 수 없는 명령: $cmd (fl --help 참조)" >&2; exit 1 ;;
esac
