#!/usr/bin/env bash
# fl — FreeLang 프로젝트 CLI
# 사용법:
#   fl build [--no-net] [--plan]
#   fl run [args...]
#   fl new <name> [--profile p1,p2,...]
#   fl pkg add <name>
#   fl profile list|add <name>[@version]

FX_HOST="${FX_HOST:-http://localhost:40330}"
SCRIPT_REAL="$(readlink -f "$0")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_REAL")" && pwd)"

_ok()   { echo "✓ $*"; }
_fail() { echo "✗ $*" >&2; }
_info() { echo "  $*"; }

cmd=$1; shift

case "$cmd" in
# ─────────────────────────────
# fl new <name> [--profile p1,p2,...]
# ─────────────────────────────
new)
  NAME=$1; shift
  if [[ -z "$NAME" ]]; then
    echo "사용법: fl new <name> [--profile p1,p2,...]" >&2; exit 1
  fi

  PROFILES=()
  while [[ $# -gt 0 ]]; do
    case $1 in
      --profile|-p) shift; IFS=',' read -ra PROFILES <<< "$1" ;;
    esac
    shift
  done

  if [[ -d "$NAME" ]]; then
    _fail "디렉토리 이미 존재: $NAME"; exit 1
  fi

  mkdir -p "$NAME"
  _ok "디렉토리 생성: $NAME/"

  # fl-project.json
  if [[ ${#PROFILES[@]} -gt 0 ]]; then
    PROF_JSON=$(printf '"%s", ' "${PROFILES[@]}"); PROF_JSON="[${PROF_JSON%, }]"
  else
    PROF_JSON='[]'
  fi

  cat > "$NAME/fl-project.json" << MANIFEST
{
  "name": "$NAME",
  "profiles": $PROF_JSON
}
MANIFEST
  _ok "fl-project.json 생성"

  # hello.fl
  cat > "$NAME/hello.fl" << FL
(println "Hello from $NAME!")
FL
  _ok "hello.fl 생성"

  # 런타임 초기화
  if [[ ${#PROFILES[@]} -gt 0 ]]; then
    echo ""
    echo "→ 런타임 초기화 중..."
    FL_PROJECT=$(cat "$NAME/fl-project.json")
    RESULT=$(curl -s -X POST "$FX_HOST/fx/project/init" \
      -H "Content-Type: application/json" \
      -d "{\"fl_project\": $FL_PROJECT}" 2>/dev/null)

    OK=$(python3 -c "import json,sys; d=json.loads('$RESULT'.replace(\"'\",\"'\")); print(d.get('ok',False))" 2>/dev/null || \
         echo "$RESULT" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('ok',False))" 2>/dev/null)

    if [[ "$OK" == "True" ]]; then
      _ok "런타임 초기화 완료"
      echo "$RESULT" | python3 -c "
import json,sys
d=json.load(sys.stdin)
for p in d.get('packages',[]):
    icon = '↩' if p['action']=='skipped' else '+'
    print(f'  {icon} {p[\"name\"]} ({p[\"action\"]})')
rp = d.get('resolved_profiles',[])
if rp: print(f'  profiles resolved: {\" → \".join(rp)}')
" 2>/dev/null
    else
      _fail "런타임 초기화 실패"
      echo "$RESULT" | python3 -m json.tool 2>/dev/null || echo "$RESULT"
    fi
  fi

  echo ""
  echo "프로젝트 준비 완료:"
  echo "  $NAME/fl-project.json"
  echo "  $NAME/hello.fl"
  ;;

# ─────────────────────────────
# fl profile list
# fl profile add <name>[@version]
# ─────────────────────────────
profile)
  subcmd=$1; shift
  case "$subcmd" in
    list)
      curl -s "$FX_HOST/fx/profiles" | python3 -c "
import json,sys
d=json.load(sys.stdin)
print(f'프로파일 {d[\"count\"]}개:')
for p in d['profiles']:
    icon = '✓' if p['installed'] else '○'
    deps = (' (depends: ' + ', '.join(p.get('depends',[])) + ')') if p.get('depends') else ''
    print(f'  {icon} {p[\"name\"]:10s}  {len(p[\"packages\"]):2d}개 함수{deps}')
" 2>/dev/null
      ;;

    add)
      SPEC=$1
      if [[ -z "$SPEC" ]]; then
        echo "사용법: fl profile add <name>[@version]" >&2; exit 1
      fi
      PNAME="${SPEC%%@*}"
      PVER="${SPEC##*@}"
      if [[ "$PVER" == "$SPEC" ]]; then PVER=""; fi

      if [[ -n "$PVER" ]]; then
        PAYLOAD="{\"profiles\":[{\"name\":\"$PNAME\",\"version\":\"$PVER\"}]}"
      else
        PAYLOAD="{\"profiles\":[\"$PNAME\"]}"
      fi

      RESULT=$(curl -s -X POST "$FX_HOST/fx/project/init" \
        -H "Content-Type: application/json" \
        -d "$PAYLOAD" 2>/dev/null)

      echo "$RESULT" | python3 -c "
import json,sys
d=json.load(sys.stdin)
if d.get('ok'):
    print(f'✓ {d[\"action\"]}')
    for p in d.get('packages',[]):
        icon = '↩' if p['action']=='skipped' else '+'
        print(f'  {icon} {p[\"name\"]} ({p[\"action\"]})')
    rp = d.get('resolved_profiles',[])
    if rp: print(f'  depends chain: {\" → \".join(rp)}')
else:
    print(f'✗ {d.get(\"error\",\"알 수 없는 오류\")}')
    if d.get('error') == 'PROFILE_ABI_MISMATCH':
        print(f'  프로파일: {d.get(\"profile\")} expected={d.get(\"expected\")} got={d.get(\"got\")}')
" 2>/dev/null
      ;;

    *)
      echo "사용법: fl profile list | fl profile add <name>[@version]" ;;
  esac
  ;;

# ─────────────────────────────
# fl build [--no-net] [--plan] [--check] [--graph]
# ─────────────────────────────
build)
  BUILD_FLAGS=()
  for arg in "$@"; do BUILD_FLAGS+=("$arg"); done

  # fx.toml 읽기
  TOML="fx.toml"
  if [[ ! -f "$TOML" ]]; then
    _fail "fx.toml 없음 (fl new <name> 으로 프로젝트 생성 먼저)"; exit 1
  fi

  PARSED=$(python3 "$SCRIPT_DIR/fl-toml-parse.py" "$TOML" 2>/dev/null)
  ENTRY=$(echo "$PARSED" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('project',{}).get('entry',''))" 2>/dev/null)
  OUTPUT=$(echo "$PARSED" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('project',{}).get('output',''))" 2>/dev/null)
  PACKAGES=$(echo "$PARSED" | python3 -c "import json,sys; d=json.load(sys.stdin); pkgs=d.get('runtime',{}).get('packages',[]); print('\n'.join(pkgs))" 2>/dev/null)
  PROFILES=$(echo "$PARSED" | python3 -c "import json,sys; d=json.load(sys.stdin); ps=d.get('runtime',{}).get('profiles',[]); print('\n'.join(ps))" 2>/dev/null)

  if [[ -z "$ENTRY" ]]; then _fail "fx.toml에 [project] entry 없음"; exit 1; fi
  if [[ -z "$OUTPUT" ]]; then OUTPUT="${ENTRY%.fl}"; fi
  if [[ ! -f "$ENTRY" ]]; then _fail "entry 파일 없음: $ENTRY"; exit 1; fi

  echo "🔨 fl build: $ENTRY → $OUTPUT"
  echo ""

  # 런타임 초기화 (packages 또는 profiles 있을 때)
  if [[ -n "$PACKAGES" ]] || [[ -n "$PROFILES" ]]; then
    echo "📦 런타임 초기화..."

    # packages 배열 → JSON
    PKG_JSON=$(echo "$PARSED" | python3 -c "
import json, sys
d = json.load(sys.stdin)
rt = d.get('runtime', {})
pkgs = rt.get('packages', [])
profs = rt.get('profiles', [])
payload = {}
if pkgs:
    payload['packages'] = pkgs
if profs:
    payload['profiles'] = profs
print(json.dumps(payload))
" 2>/dev/null)

    INIT_RESULT=$(curl -s -X POST "$FX_HOST/fx/project/init" \
      -H "Content-Type: application/json" \
      -d "$PKG_JSON" 2>/dev/null)

    INIT_OK=$(echo "$INIT_RESULT" | python3 -c "import json,sys; print(json.load(sys.stdin).get('ok',False))" 2>/dev/null)
    if [[ "$INIT_OK" == "True" ]]; then
      echo "$INIT_RESULT" | python3 -c "
import json, sys
d = json.load(sys.stdin)
added = [p['name'] for p in d.get('packages',[]) if p.get('action') != 'skipped']
skipped = [p['name'] for p in d.get('packages',[]) if p.get('action') == 'skipped']
if added:   print('  + ' + ', '.join(added))
if skipped: print('  ↩ skipped: ' + ', '.join(skipped))
" 2>/dev/null
      _ok "런타임 준비 완료"
    else
      ERR=$(echo "$INIT_RESULT" | python3 -c "import json,sys; print(json.load(sys.stdin).get('error',''))" 2>/dev/null)
      _fail "런타임 초기화 실패: $ERR"
      echo "$INIT_RESULT" | python3 -m json.tool 2>/dev/null
      exit 1
    fi
    echo ""
  fi

  # fl-build.sh 실행
  exec bash "$SCRIPT_DIR/fl-build.sh" "$ENTRY" "$OUTPUT" "${BUILD_FLAGS[@]}"
  ;;

# ─────────────────────────────
# fl run [args...]
# ─────────────────────────────
run)
  TOML="fx.toml"
  if [[ ! -f "$TOML" ]]; then _fail "fx.toml 없음"; exit 1; fi
  PARSED=$(python3 "$SCRIPT_DIR/fl-toml-parse.py" "$TOML" 2>/dev/null)
  OUTPUT=$(echo "$PARSED" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('project',{}).get('output',''))" 2>/dev/null)
  if [[ -z "$OUTPUT" ]]; then _fail "fx.toml에 output 없음"; exit 1; fi
  if [[ ! -f "./$OUTPUT" ]]; then
    _info "바이너리 없음 — 먼저 빌드합니다..."
    bash "$0" build || exit 1
    echo ""
  fi
  exec "./$OUTPUT" "$@"
  ;;

# ─────────────────────────────
# fl pkg add <name>
# fl pkg list
# ─────────────────────────────
pkg)
  subcmd=$1; shift
  case "$subcmd" in
    add)
      NAME=$1
      if [[ -z "$NAME" ]]; then echo "사용법: fl pkg add <name>" >&2; exit 1; fi
      # packages/*.json 확인
      PKG_FILE="$SCRIPT_DIR/packages/$NAME.json"
      if [[ ! -f "$PKG_FILE" ]]; then
        _fail "패키지 없음: $NAME (packages/$NAME.json 없음)"; exit 1
      fi
      echo "📦 패키지 추가: $NAME"
      BODY=$(cat "$PKG_FILE")
      RESULT=$(curl -s -X POST "$FX_HOST/fx/fns" \
        -H "Content-Type: application/json" \
        -d "$BODY" 2>/dev/null)
      OK=$(echo "$RESULT" | python3 -c "import json,sys; print(json.load(sys.stdin).get('ok',False))" 2>/dev/null)
      if [[ "$OK" == "True" ]]; then
        _ok "$NAME 등록"
        # 빌드
        BUILD_RESULT=$(curl -s -X POST "$FX_HOST/fx/build" 2>/dev/null)
        BUILD_OK=$(echo "$BUILD_RESULT" | python3 -c "import json,sys; print(json.load(sys.stdin).get('ok',False))" 2>/dev/null)
        if [[ "$BUILD_OK" == "True" ]]; then
          _ok "런타임 빌드 완료"
        else
          _fail "런타임 빌드 실패"
        fi
      else
        ERR=$(echo "$RESULT" | python3 -c "import json,sys; print(json.load(sys.stdin).get('error',''))" 2>/dev/null)
        _fail "$NAME 등록 실패: $ERR"
      fi
      ;;
    list)
      curl -s "$FX_HOST/fx/fns" | python3 -c "
import json,sys
d=json.load(sys.stdin)
fns=d.get('functions',d.get('fns',[]))
print(f'설치된 패키지 {len(fns)}개:')
for f in sorted(fns, key=lambda x: x.get('name','')):
    print(f'  {f.get(\"name\",\"?\")}  ({f.get(\"args\",\"?\")}인자)')
" 2>/dev/null
      ;;
    *)
      echo "사용법: fl pkg add <name> | fl pkg list" ;;
  esac
  ;;

# ─────────────────────────────
help|--help|-h|'')
  cat << HELP
fl — FreeLang 프로젝트 CLI

명령어:
  fl build [--no-net] [--plan]           fx.toml 읽어 런타임 초기화 + ELF 빌드
  fl run [args...]                       빌드 후 바이너리 실행 (없으면 자동 빌드)
  fl new <name> [--profile p1,p2,...]   프로젝트 생성 + 런타임 초기화
  fl pkg list                            설치된 패키지 목록
  fl pkg add <name>                      패키지 추가 + 런타임 재빌드
  fl profile list                        프로파일 목록
  fl profile add <name>[@version]        프로파일 추가

환경변수:
  FX_HOST  fl-source-manager 주소 (기본: http://localhost:40330)

예시:
  fl new my-api --profile web,math       프로젝트 생성
  cd my-api && fl build                  빌드
  fl run                                 실행
  fl pkg add str-starts-with             패키지 추가
  fl build --plan                        의존성 그래프만 출력
HELP
  ;;

*)
  echo "알 수 없는 명령: $cmd (fl --help 참조)" >&2; exit 1 ;;
esac
