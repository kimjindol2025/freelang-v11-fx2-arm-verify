;; fx.rules — spec/conformance.fl 용 최소 규칙
;;
;; 이 파일은 fl-rules-runner.fl에서 로드된다.
;; 각 check-*는 ($src $lines) 를 인자로 받는 함수를 등록한다.

(defn _line-has [$lines $needle]
  (some (fn [$l] (str-includes $l $needle)) $lines))

(defn _line-has-any [$lines $needles]
  (some (fn [$n] (_line-has $lines $n)) $needles))

(defn _line-starts-with [$lines $prefix]
  (some (fn [$l] (str-starts-with (str-trim $l) $prefix)) $lines))

(defn _line-has-try-form [$lines]
  (or (_line-starts-with $lines "(try")
      (_line-has $lines " (try")))

;; 금지: range 단인자
(check-error
  "range 단인자 금지"
  (fn [$src $lines]
    (if (_line-has $lines "(range ")
      (if (_line-has $lines "(range 0 ") nil
        "use (range 0 n) instead of (range n)")
      nil)))

;; 금지: str-includes를 숫자와 비교
(check-error
  "str-includes는 boolean"
  (fn [$src $lines]
    (if (_line-has $lines "(= (str-includes")
      "do not compare str-includes with 1"
      nil)))

;; 금지: server-json에 맵 리터럴 직접 전달
(check-error
  "server-json 맵 직접전달 금지"
  (fn [$src $lines]
    (if (_line-has $lines "(server-json {")
      "server-json does not accept a map literal directly and silently returns an empty body. Use fx-server-json instead: (fx-server-json {...})"
      nil)))

;; 경고: server-json에 변수 직접 전달
(check-warn
  "server-json 변수 직접전달 확인"
  (fn [$src $lines]
    (if (_line-has $lines "(server-json $")
      "server-json expects an already stringified JSON string. If the value is a map/vector, use fx-server-json or json-stringify first."
      nil)))

;; 금지: 언더스코어 표준 함수명
(check-error
  "케밥케이스 함수명"
  (fn [$src $lines]
    (if (_line-has-any $lines
          ["file_read" "file_write" "file_exists"
           "json_parse" "json_stringify" "json_try_parse"
           "str_includes" "str_contains" "str_split" "str_join" "str_trim" "str_replace"
           "sqlite_query" "sqlite_exec" "sqlite_open" "sqlite_one"])
      "underscore function names are forbidden"
      nil)))

;; 금지: try/catch
(check-error
  "try/catch 미지원"
  (fn [$src $lines]
    (if (_line-has-try-form $lines)
      "try/catch is not supported in fx2. Wrap fallible logic in a function returning Result-style maps like {\"ok\" true \"value\" ...} / {\"ok\" false \"error\" ...} instead; use result-ok?/result-err? from fl-common/fx2.fl."
      nil)))

;; 경고: 클로저 캡처는 현재 제약
(check-warn
  "outer let 캡처"
  (fn [$src $lines]
    (if (_line-has $lines "(fn [")
      "fn closure capture is limited; prefer atom/parameter passing"
      nil)))
