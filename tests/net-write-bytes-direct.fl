;; Direct FreeLang call probe for binary-safe write.
(let [$listen (fxb-net-listen-address "127.0.0.1" 19381)
      $dest (fxb-net-connect-timeout "127.0.0.1" 19382 3000)]
  (if (or (< $listen 0) (not (= (get $dest "status") "ok")))
    (process-exit 1)
    (do (fxb-net-set-nonblocking $listen true)
        (let [$a (fxb-net-accept-timeout $listen 5000)
              $outfd (get $dest "fd")]
          (if (not (= (get $a "status") "ok"))
            (process-exit 1)
            (let [$infd (get $a "fd")
                  $r (fxb-net-read-timeout $infd 5 3000)
                  $data (get $r "data")
                  $w (if (= (get $r "status") "ok")
                       (fxb-net-write-bytes-timeout $outfd $data 5 3000)
                       {:status "read-failed" :bytes 0})
                  $zero (fxb-net-write-bytes-timeout $outfd "Z" 0 3000)
                  $short (fxb-net-write-bytes-timeout $outfd "XYZ" 2 3000)
                  $oversize (fxb-net-write-bytes-timeout $outfd "abc" 4 3000)
                  $negative (fxb-net-write-bytes-timeout $outfd "abc" -1 3000)]
              (println (str "READ_STATUS=" (get $r "status")))
              (println (str "ZERO_STATUS=" (get $zero "status") " BYTES=" (get $zero "bytes")))
              (println (str "SHORT_STATUS=" (get $short "status") " BYTES=" (get $short "bytes")))
              (println (str "OVERSIZE_STATUS=" (get $oversize "status")))
              (println (str "NEGATIVE_STATUS=" (get $negative "status")))
              (println (str "WRITE_STATUS=" (get $w "status") " BYTES=" (get $w "bytes")))
              (println (str "SHA256=" (sha256 $data)))
              (fxb-net-close $infd)
              (fxb-net-close $outfd)
              (fxb-net-close $listen)
              (if (and (= (get $r "status") "ok")
                       (= (get $w "status") "ok")
                       (and (= (get $w "bytes") 5) (= (get $zero "status") "ok") (= (get $zero "bytes") 0) (= (get $short "status") "ok") (= (get $short "bytes") 2) (= (get $oversize "status") "error") (= (get $negative "status") "error"))))
                (process-exit 0)
                (process-exit 1))))))))
