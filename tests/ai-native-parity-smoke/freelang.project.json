          "source": "cases/list.fl"
        },
        {
          "name": "object",
          "source": "cases/object.fl"
        },
        {
          "name": "function",
          "source": "cases/function.fl"
        },
        {
          "name": "recursion",
          "source": "cases/recursion.fl"
        },
        {
          "name": "scope",
          "source": "cases/scope.fl"
        },
        {
          "name": "higher_order",
          "source": "cases/higher_order.fl"
        },
        {
          "name": "map",
          "source": "cases/map.fl"
        },
        {
          "name": "filter",
          "source": "cases/filter.fl"
        },
        {
          "name": "reduce",
          "source": "cases/reduce.fl"
        },
        {
          "name": "rest",
          "source": "cases/rest.fl"
        },
        {
          "name": "json",
          "source": "cases/json.fl"
        },
        {
