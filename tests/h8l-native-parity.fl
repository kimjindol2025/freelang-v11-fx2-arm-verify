(do
  (try (println "H8L_TRY_PASS")
       (catch [err] (println "H8L_CATCH_PASS")))
  (try (try (throw "inner")
           (catch [err] (println "H8L_CATCH_PASS")))
       (catch [err] (println "H8L_CATCH_PASS")))
  (try (println "H8L_TRY_PASS")
       (finally (println "H8L_FINALLY_PASS")))
  (try (throw "boom")
       (catch [err] (println "H8L_THROW_PASS"))
       (finally (println "H8L_FINALLY_PASS")))
  (try (throw {:type "ValidationError" :category "ValidationError" :code "E_BAD_INPUT" :message "bad input"})
       (catch [err] (println "H8L_TYPED_ERROR_PASS")))
  (println "H8L_JSON_PASS"))
