(define $headers (json-parse "{\"X-Parity-Test\":\"freelang\"}"))
(define $get-task (fl-async-http-get "http://127.0.0.1:18762/get" $headers))
(define $get (fl-async-await $get-task 3000))
(fl-async-release $get-task)
(define $post-task (fl-async-http-post "http://127.0.0.1:18762/post" "payload-한글" $headers))
(define $post (fl-async-await $post-task 3000))
(fl-async-release $post-task)
(define $header-task (fl-async-http-get "http://127.0.0.1:18762/header" $headers))
(define $header (fl-async-await $header-task 3000))
(fl-async-release $header-task)
(define $error-task (fl-async-http-get "http://127.0.0.1:1/error" $headers))
(define $error (fl-async-await $error-task 1000))
(fl-async-release $error-task)
(define $timeout-task (fl-async-http-get "http://127.0.0.1:18762/delay" $headers))
(define $timeout (fl-async-await $timeout-task 75))
(define $timeout-release (fl-async-release $timeout-task))
(define $cancel-task (fl-async-http-get "http://127.0.0.1:18762/delay" $headers))
(define $cancel-wait (fl-async-sleep 20))
(fl-async-await $cancel-wait 1000)
(fl-async-release $cancel-wait)
(define $cancel (fl-async-cancel $cancel-task))
(define $cancel-result (fl-async-await $cancel-task 1000))
(fl-async-release $cancel-task)
(println (json-stringify (list $get $post $header $error $timeout $cancel-result)))
