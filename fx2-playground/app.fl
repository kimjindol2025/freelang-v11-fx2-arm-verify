;; fx2-playground — bounded native checker
(define SERVER_PORT 8488)
(define MAX_SOURCE_BYTES 1048576)
(define MAX_ACTIVE_CHECKS 8)
(define ACTIVE_CHECKS (atom 0))

(defn text-or [$value $fallback] (if (= $value nil) $fallback $value))

(defn html-escape [$value]
  (let [$text (str (text-or $value ""))
        $a (str-replace $text "&" "&amp;")
        $b (str-replace $a "<" "&lt;")
        $c (str-replace $b ">" "&gt;")
        $d (str-replace $c "\"" "&quot;")]
    (str-replace $d "'" "&#39;")))

(defn request-code [$req]
  (let [$body (get $req "body")]
    (if (= $body nil) "" (text-or (get $body "code") ""))))

(defn result [$ok $source $output $exit $request-id $status]
  {"ok" $ok "source" $source "output" (text-or $output "")
   "exit" $exit "request_id" $request-id "status" $status})

(defn release-check []
  (swap! ACTIVE_CHECKS (fn [$n] (- $n 1))))

(defn check-source [$source]
  (if (> (str-length $source) MAX_SOURCE_BYTES)
    (result false "" "source exceeds 1MB" "413" "" 413)
    (let [$active (swap! ACTIVE_CHECKS (fn [$n] (+ $n 1)))]
      (if (> $active MAX_ACTIVE_CHECKS)
        (do
          (release-check)
          (result false $source "too many active checks" "429" "" 429))
        (let [$request-id (str-trim (process-run "mktemp -d /tmp/fx2-playground.XXXXXX"))]
          (if (= $request-id "")
            (do
              (release-check)
              (result false $source "cannot create request workspace" "500" "" 500))
            (let [$source-file (str $request-id "/source.fl")
                  $log-file (str $request-id "/build.log")
                  $output-file (str $request-id "/check-bin")
                  $_write (file-write $source-file $source)
                  $exit (str-trim (process-run
                    (str "timeout 15s bash /root/kim/freelang-v11-fx2/fl-build.sh "
                         $source-file " " $output-file " --no-net >" $log-file " 2>&1; echo $?")))
                  $output (text-or (file-read $log-file) "")
                  $ok (= $exit "0")
                  $status (if $ok 200 (if (= $exit "124") 408 422))
                  $_cleanup (process-run (str "rm -rf " $request-id))]
              (release-check)
              (result $ok $source $output $exit $request-id $status))))))))

(defn page [$source $result]
  (let [$safe-source (html-escape $source)
        $safe-result (html-escape (get $result "output"))
        $status (if (get $result "ok") "검사 통과" "검사 결과")]
    (str
      "<!doctype html><html lang='ko'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'>"
      "<title>fx2 Playground</title><style>body{margin:0;background:#0b1220;color:#e6edf3;font-family:system-ui,sans-serif}.wrap{max-width:1100px;margin:auto;padding:42px 20px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.panel{padding:18px;border:1px solid #2d3748;border-radius:16px;background:#111827}textarea,pre{width:100%;min-height:360px;box-sizing:border-box;padding:14px;background:#080d16;color:#e6edf3;border:1px solid #344054;border-radius:12px;font:14px/1.6 monospace;white-space:pre-wrap}button{padding:12px 18px;background:#238636;color:white;border:0;border-radius:10px;font-weight:700}@media(max-width:800px){.grid{grid-template-columns:1fr}}</style></head><body><main class='wrap'>"
      "<p>FreeLang fx2 · Bounded Native Playground</p><h1>fx2 언어 체크</h1>"
      "<p>요청별 작업공간, 1MB 소스 제한, 15초 timeout, 동시 8개 제한을 적용합니다.</p>"
      "<div class='grid'><section class='panel'><h2>fx2 코드</h2><form method='post' action='/check'><textarea name='code'>" $safe-source "</textarea><br><button type='submit'>검사하기</button></form></section>"
      "<section class='panel'><h2>" $status "</h2><pre>" $safe-result "</pre></section></div>"
      "<p>API: POST /api/check · JSON field: code</p></main></body></html>")))

(defn empty-result [] {"ok" true "source" "(println \"Hello, fx2!\")" "output" "코드를 입력하고 검사하세요."})
(defn handle-home [$req] (let [$r (empty-result)] (server_html (page (get $r "source") $r))))
(defn handle-check [$req]
  (let [$r (check-source (request-code $req)) $body (json-stringify $r)]
    (if (= (get $r "status") 200) (server_json $body) (server_status (get $r "status") $body))))
(defn handle-check-page [$req]
  (let [$source (request-code $req) $r (check-source $source)]
    (server_status (get $r "status") (page $source $r))))

(server_get "/" "handle-home")
(server_post "/api/check" "handle-check")
(server_post "/check" "handle-check-page")
(println (str "fx2 Playground — http://localhost:" SERVER_PORT))
(defn warmup []
  (let [$warm-file "/tmp/fx2-playground-warm.fl"
        $_write (file-write $warm-file "(println \"warmup\")")
        $_build (process-run (str "bash /root/kim/freelang-v11-fx2/fl-build.sh " $warm-file " /tmp/fx2-playground-warm-bin --no-net >/tmp/fx2-playground-warm.log 2>&1"))
        $_cleanup (process-run "rm -f /tmp/fx2-playground-warm.fl /tmp/fx2-playground-warm-bin /tmp/fx2-playground-warm.log")]
    true))

(warmup)
(server_start SERVER_PORT)
