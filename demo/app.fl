;; app.fl — 설치된 C 패키지 함수를 사용하는 데모
;; 컴파일: bash ../fl-build.sh app.fl app-bin

(println "== fx2 Runtime Package Demo ==")
(println "")

;; str-indent: C로 구현된 문자열 들여쓰기 함수
(println "str-indent:")
(println (str-indent "Hello, fx2!" 4))
(println (str-indent "C 함수가 FL에서 실행됩니다." 2))
(println "")

;; math-clamp: C로 구현된 범위 제한 함수
(println "math-clamp:")
(println (str "  clamp(120, 0, 100) = " (math-clamp 120 0 100)))
(println (str "  clamp(-5,  0, 100) = " (math-clamp -5 0 100)))
(println (str "  clamp(42,  0, 100) = " (math-clamp 42 0 100)))
(println "")

;; str-truncate: C로 구현된 문자열 자르기 함수
(println "str-truncate:")
(println (str-truncate "FreeLang Self-Extensible Runtime Platform" 20 "..."))
(println (str-truncate "short" 20 "..."))
(println "")

(println "✅ git clone → (run setup) → C 런타임 패키지 설치 → 바이너리 실행")
