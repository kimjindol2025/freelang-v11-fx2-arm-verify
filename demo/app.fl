;; app.fl — fx2 패키지 데모
;; 컴파일: bash ../fl-build.sh app.fl demo-bin

(println "== fx2 Runtime Package Demo ==")
(println (str-repeat "-" 40))
(println "")

(println "[string]")
(println (str-indent "str-indent: 들여쓰기" 2))
(println (str-truncate "str-truncate: 긴 문자열을 자릅니다" 20 "..."))
(println (str-rpad "str-rpad:" 20 "."))
(println (str "str-count 'l' in 'hello world': " (str-count "hello world" "l")))
(println "")

(println "[math]")
(println (str "math-clamp(150, 0, 100) = " (math-clamp 150 0 100)))
(println (str "math-lerp(0, 100, 0.3)  = " (math-lerp 0 100 0.3)))
(println (str "math-round-n(3.14159,2) = " (math-round-n 3.14159 2)))
(println (str "math-sign(-42)          = " (math-sign -42)))
(println "")

(println "[time]")
(let [$t0 (time-now-ms)]
  (println (str "time-now-ms:  " $t0))
  (println (str "time-elapsed: " (time-elapsed $t0) "ms")))
(println "")

(println "[path]")
(let [$p "/home/kimjin/freelang-v11-fx2/demo/app.fl"]
  (println (str "path-basename: " (path-basename $p)))
  (println (str "path-dirname:  " (path-dirname $p))))
(println "")

(println (str-repeat "-" 40))
(println "git clone -> run setup -> C runtime packages -> binary")
