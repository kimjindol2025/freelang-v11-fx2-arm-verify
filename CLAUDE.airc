;; AIRC — FreeLang fx2 Claude Handoff
;; Keep this file for stable facts and standing rules only.

{
  "project": "freelang-v11-fx2",

  "core_facts": [
    {
      "grade": "MUST",
      "rule": "Use the repo docs as the source of truth.",
      "references": [
        "docs/CANON.md",
        "docs/SPEC.md",
        "docs/WORKFLOW.md",
        "docs/CONFORMANCE.md"
      ]
    },
    {
      "grade": "MUST",
      "rule": "Commit only after fixpoint verification passes.",
      "reference": "verify-fixpoint.sh"
    }
  ],

  "language_constraints": [
    {
      "grade": "MUST",
      "rule": "server-json takes one argument only.",
      "note": "Use server-status for non-200 responses."
    },
    {
      "grade": "KNOWN LIMITATION",
      "rule": "fn does not automatically capture outer let bindings.",
      "note": "Use an atom or another explicit bridge when a closure-like capture is required."
    },
    {
      "grade": "MUST",
      "rule": "str-includes returns a boolean value.",
      "note": "Do not compare it to 1."
    },
    {
      "grade": "MUST",
      "rule": "range needs an explicit start and end.",
      "note": "Use (range 0 n), not (range n)."
    }
  ],

  "runtime_constraints": [
    {
      "grade": "MUST",
      "rule": "HTML output is caller-managed.",
      "note": "Escape user-controlled content before passing it to server-html."
    },
    {
      "grade": "MUST",
      "rule": "JSON embedded in <script> must not contain a literal </script> terminator.",
      "note": "Escape as <\/script> or \u003C/script> before embedding."
    },
    {
      "grade": "MUST",
      "rule": "SQL that includes external input must use the prepared API.",
      "note": "Prefer fxb-sqlite-query-p / fxb-sqlite-exec-p."
    }
  ],

  "coding_standards": [
    {
      "grade": "SHOULD",
      "rule": "Use kebab-case for FL function names."
    },
    {
      "grade": "SHOULD",
      "rule": "Keep functions small enough to debug through generated C when needed."
    },
    {
      "grade": "SHOULD",
      "rule": "Prefer explicit helpers for status, JSON, and validation instead of ad hoc string assembly."
    }
  ],

  "security_rules": [
    {
      "grade": "MUST",
      "rule": "Escape all HTML that includes user-controlled data."
    },
    {
      "grade": "MUST",
      "rule": "Escape </script> when serializing JSON into inline script blocks."
    },
    {
      "grade": "MUST",
      "rule": "Validate external input before using it in SQL, HTML, or route construction."
    }
  ],

  "validation_rules": [
    {
      "grade": "MUST",
      "rule": "Build success is not enough; check fixpoint PASS too."
    },
    {
      "grade": "MUST",
      "rule": "New APIs should have at least one happy-path test and one failure-path test."
    },
    {
      "grade": "SHOULD",
      "rule": "New syntax or runtime behavior should come with a regression test."
    },
    {
      "grade": "SHOULD",
      "rule": "If a build fails, reproduce it with the lowest-level command that shows the error clearly."
    }
  ],

  "review_policy": {
    "source": "LANGUAGE-REVIEW-POLICY.md",
    "rule": "Classify review findings as LANGUAGE SEMANTICS, COMPILER BUG, RUNTIME CONSTRAINT, API CONSTRAINT, STDLIB GAP, or APPLICATION BUG.",
    "grading": "Always record severity, breaking status, fixability, and recommended resolution."
  },

  "document_index": [
    {
      "path": "BUILD.md",
      "purpose": "Build and run commands, environment setup, and platform-specific compiler notes."
    },
    {
      "path": "DEBUG.md",
      "purpose": "Failure reproduction, low-level compiler debugging, and log recovery steps."
    },
    {
      "path": "TESTING.md",
      "purpose": "Conformance checks, app smoke tests, and API-level verification guidance."
    },
    {
      "path": "SECURITY.md",
      "purpose": "Escaping rules, SQL safety, and input-validation policy."
    },
    {
      "path": "ROADMAP.md",
      "purpose": "Current priorities and planned work."
    },
    {
      "path": "CHANGELOG.md",
      "purpose": "Notable changes, especially document and workflow changes."
    }
  ]
}
