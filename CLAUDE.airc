  "gogs": "gogs.dclub.kr/kim/freelang-v11-fx2",
  "fixpoint_sha": "4b65157f",
  "last_updated": "2026-06-21",

  "build_command": {
    "standard": "CGC_BIN=/home/kimjin/freelang-v11/bin/cgc-bin bash /home/kimjin/freelang-v11-fx2/fl-build.sh <input.fl> <output-bin>",
    "shortcut": "fl build <input.fl> <output-bin>",
    "verify_fixpoint": "bash /home/kimjin/freelang-v11-fx2/verify-fixpoint.sh"
  },

  "critical_rules": [
    {
      "rule": "고정점 PASS 없이 커밋 금지",
      "detail": "verify-fixpoint.sh → gen-b == gen-c SHA 일치 확인 후 커밋",
      "blog": "#1229"
    },
    {
      "rule": "server_json은 1인자",
      "detail": "fx2 server_json(json_str) — 상태코드 포함 불가. 오류 응답: (server-status 404 (json-stringify {...}))",
      "blog": "#1384"
    },
    {
      "rule": "fn은 클로저 아님",
      "detail": "fn 내부에서 outer let 바인딩 접근 불가 → atom 우회 필수",
      "example": "(define _VAL (atom nil)) ... $_ (reset! _VAL $outer) (map (fn [$x] (deref _VAL)) coll)",
      "blog": "#1384"
    },
    {
      "rule": "str-includes는 boolean",
      "detail": "(= (str-includes ...) 1) 항상 false. 직접 truthy 사용: (str-includes $s sub)",
      "blog": "#1384"
    },
    {
      "rule": "fxb-sqlite-*-p 필수",
      "detail": "외부 입력 포함 SQL은 반드시 fxb-sqlite-query-p / fxb-sqlite-exec-p 사용",
      "blog": "#1274"
    },
    {
      "rule": "케밥케이스 함수명",
      "detail": "file_read X → file-read O. str_includes X → str-includes O",
      "blog": "#1240"
    },
    {
      "rule": "(range 0 n) 필수",
      "detail": "(range n) 단인자 = 빈 배열. 반드시 (range 0 n) 사용",
      "blog": "#1330"
    }
  ],

  "v11_to_fx2_mapping": {
    "{:type sqlite :path ...}":    "(fxb-sqlite-open path)",
    "db-exec DB sql [p]":          "(fxb-sqlite-exec-p DB sql [p])",
    "db-query DB sql [p]":         "(fxb-sqlite-query-p DB sql [p])",
    "?? x default":                "(or-else x default)  ;; 직접 구현 필요",
    "sha256_short x":              "(str-slice (sha256 x) 0 8)",
    "regex_extract_all":           "str-split + filter + 직접 추출 함수",
    "server-json {...} 404":       "(server-status 404 (json-stringify {...}))",
    "json_merge m1 m2":            "(assoc m1 key val)",
    "http_post url h b":           "(http-request \"POST\" url headers body-str)",
    "number->string":              "(str $n)",
    "fl_bool":                     "fl_int(0) / fl_int(1)"
  },

  "error_vaccine": {
    "script": "/home/kimjin/freelang-v11-fx2/fl-error-vaccine.py",
    "patterns": "/home/kimjin/freelang-v11-fx2/fl-error-patterns.json",
    "count": 11,
    "usage": "fl-error-vaccine.py <gcc-error.txt>",
    "note": "새 에러 발견 시 patterns.json에 즉시 추가 후 git push"
  },

  "build_pipeline": [
    "① 전처리 (load 인라인)",
    "② 괄호 검사",
    "③ 시맨틱 분석 (SQL ? 개수 + 인젝션 경고)",
    "④ fx.rules 규칙 검사 (프로젝트별 커스텀)",
    "⑤ FL → C (cgc-bin)",
    "⑥ gcc -fsyntax-only 0.3초 타입 검사",
    "⑦ app.o 캐시 + link → ELF"
  ],

  "apps": [
    {"name": "fx-notify",    "port": 40300, "pm2_id": "fx-notify"},
    {"name": "fx-monitor",   "port": 40301, "pm2_id": "fx-monitor"},
