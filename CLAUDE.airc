  "debug_workflow": {
    "when_build_fails": [
      "1. fl-error-vaccine.py 실행 (GCC 에러 번역)",
      "2. 직접 전처리: python3 fl-str-split.py <file.fl> > preprocessed.fl",
      "3. cgc-bin preprocessed.fl out.c",
      "4. gcc -fsyntax-only -I /home/kimjin/freelang-v11-fx2/runtime out.c 2>&1 | grep 'error:'",
      "5. #line 디렉티브로 FL 원본 줄 추적"
    ],
    "when_fl_build_sh_fails": "fl-build.sh는 실패 시 SYNTAX_LOG + C_FILE + PREPROCESSED 자동 삭제. 위 4단계 수동 실행"
  },

  "common_silent_bugs": {
    "http_get_double_parse": "http-get/http-post → 이미 파싱된 객체 반환. json-parse 재호출 금지",
    "health_always_ok":      "/health 엔드포인트가 항상 healthy → fail-open. 실제 상태 집계 필수",
    "str_includes_eq_1":     "(= (str-includes ...) 1) 항상 false — boolean vs int 혼동",
    "range_single_arg":       "(range n) → 빈 배열. (range 0 n) 필수",
    "fn_closure_capture":    "fn 내 outer let 변수 → C 스코프 밖 → atom 우회"
  },

